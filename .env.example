# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
DEFAULT_MODEL=claude-sonnet-4-20250514
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=4096

# Agent Configuration
AGENT_NAME=GreatWall
